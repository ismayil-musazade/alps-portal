// Alps Academy Management Platform — data model (Build Brief §17)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- enums ----------

enum Role {
  MANAGER
  STAFF
  TEACHER
  STUDENT
  PARENT

  /// One of the five shared walk-in exam desks — not a person. It reaches the
  /// exam screen and nothing else, and the result belongs to the named
  /// candidate on the sitting, never to the seat. Listed last so seats sort to
  /// the bottom of any role-ordered list.
  EXAM_SEAT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum LeadStatus {
  NEW
  CONTACTED
  PLACEMENT_BOOKED
  PLACEMENT_DONE
  TRIAL_BOOKED
  INTERESTED
  WAITING_DECISION
  CONVERTED
  LOST
}

enum LeadSource {
  INSTAGRAM
  WHATSAPP
  REFERRAL
  WALK_IN
  PHONE_CALL
  WEBSITE
  OTHER
}

enum StudentStatus {
  ACTIVE
  FROZEN
  COMPLETED
  DROPPED
  WAITING_GROUP
}

enum CourseType {
  IELTS
  SAT
  GENERAL_ENGLISH
  OTHER
}

enum GroupStatus {
  ACTIVE
  FINISHED
  PLANNED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum TaskCategory {
  PRACTICE_TEST
  VOCAB_LIST
  READING_ARTICLE
  HOMEWORK
  WRITING_TASK
  SPEAKING_TASK
  SKILL_CHECKLIST
  EXAM_REVIEW
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  MISSING
  LATE
}

enum SkillStatus {
  NOT_STARTED
  LEARNING
  NEEDS_IMPROVEMENT
  GOOD
  MASTERED
}

enum ExamType {
  PLACEMENT
  PROGRESS
  MOCK
  FINAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum NoteVisibility {
  MANAGER_ONLY
  STAFF
  TEACHER
}

enum ActivityType {
  NOTE
  CALL
  STATUS_CHANGE
  FOLLOW_UP
}

enum ReminderStatus {
  OPEN
  DONE
  DISMISSED
}

enum StaffTaskStatus {
  TODO
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
}

enum FileReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TestPaperStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SittingStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  GRADED
  CANCELLED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  SHORT_TEXT
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

/// Where a reminder came from. Automatic ones are kept in step with the thing
/// that created them, so a changed deadline never leaves a stale bell behind.
enum ReminderKind {
  MANUAL
  LEAD_FOLLOW_UP
  STAFF_TASK
}

enum AchievementCategory {
  OLYMPIAD
  EXAM
  CERTIFICATE
  COMPETITION
  AWARD
  OTHER
}

// ---------- models ----------

model User {
  id                 String     @id @default(cuid())
  name               String
  email              String?    @unique
  phone              String?    @unique
  passwordHash       String
  role               Role
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  studentProfile       StudentProfile? @relation("StudentUser")
  parentLinks          ParentLink[]
  taughtGroups         Group[]         @relation("GroupTeacher")
  enrollmentsAsTeacher Enrollment[]    @relation("EnrollmentTeacher")
  responsibleLeads     Lead[]          @relation("LeadStaff")
  leadActivities       LeadActivity[]
  internalNotes        InternalNote[]
  loginAttempts        LoginAttempt[]

  remindersOwned     Reminder[]         @relation("ReminderOwner")
  remindersCreated   Reminder[]         @relation("ReminderAuthor")
  staffTasksAssigned StaffTask[]        @relation("StaffTaskAssignee")
  staffTasksCreated  StaffTask[]        @relation("StaffTaskAuthor")
  staffTaskFiles     StaffTaskFile[]
  examSeat           ExamSeat?
  posts              Post[]
  taskComments       StaffTaskComment[]
  achievements       Achievement[]
  messagesSent       Message[]          @relation("MessageSender")
  messagesReceived   Message[]          @relation("MessageRecipient")
}

model Lead {
  id                 String      @id @default(cuid())
  fullName           String
  phone              String
  parentName         String?
  parentPhone        String?
  dateOfBirth        DateTime?
  school             String?
  gradeLevel         String?
  source             LeadSource  @default(OTHER)
  interestedCourse   CourseType?
  currentLevel       String?
  targetScore        String?
  preferredSchedule  String?
  groupPreference    String? // group / individual
  status             LeadStatus  @default(NEW)
  responsibleStaffId String?
  responsibleStaff   User?       @relation("LeadStaff", fields: [responsibleStaffId], references: [id])
  firstContactAt     DateTime?
  nextFollowUpAt     DateTime?
  lastContactNote    String?
  followUpNote       String? // why this person is being followed up
  lostReason         String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  activities     LeadActivity[]
  internalNotes  InternalNote[]
  reminders      Reminder[]
  achievements   Achievement[]
  testSittings   TestSitting[]
  studentProfile StudentProfile? @relation("LeadConversion")

  @@index([status])
  @@index([responsibleStaffId])
  @@index([nextFollowUpAt])
}

model LeadActivity {
  id        String       @id @default(cuid())
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation(fields: [authorId], references: [id])
  type      ActivityType @default(NOTE)
  body      String
  createdAt DateTime     @default(now())

  @@index([leadId])
}

model StudentProfile {
  id             String        @id @default(cuid())
  userId         String?       @unique
  user           User?         @relation("StudentUser", fields: [userId], references: [id])
  leadId         String?       @unique
  lead           Lead?         @relation("LeadConversion", fields: [leadId], references: [id])
  fullName       String
  phone          String?
  parentName     String?
  parentPhone    String?
  dateOfBirth    DateTime?
  school         String?
  gradeLevel     String?
  currentLevel   String?
  previousScores String?
  strengths      String?
  weaknesses     String?
  learningNotes  String?
  status         StudentStatus @default(ACTIVE)
  startDate      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  parentLinks   ParentLink[]
  enrollments   Enrollment[]
  goals         Goal[]
  tasks         StudentTask[]
  skillStatuses StudentSkillStatus[]
  exams         Exam[]
  attendance    Attendance[]
  reportCards   ReportCard[]
  internalNotes InternalNote[]
  reminders     Reminder[]
  achievements  Achievement[]

  @@index([status])
  @@index([fullName])
}

model ParentLink {
  id           String         @id @default(cuid())
  parentUserId String
  parentUser   User           @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, studentId])
}

model Course {
  id          String     @id @default(cuid())
  name        String
  type        CourseType
  description String?

  groups      Group[]
  enrollments Enrollment[]
}

model Group {
  id        String      @id @default(cuid())
  name      String
  courseId  String
  course    Course      @relation(fields: [courseId], references: [id])
  teacherId String?
  teacher   User?       @relation("GroupTeacher", fields: [teacherId], references: [id])
  schedule  String?
  status    GroupStatus @default(ACTIVE)
  createdAt DateTime    @default(now())

  enrollments Enrollment[]
  attendance  Attendance[]

  @@index([teacherId])
}

model Enrollment {
  id        String           @id @default(cuid())
  studentId String
  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id])
  groupId   String?
  group     Group?           @relation(fields: [groupId], references: [id])
  teacherId String?
  teacher   User?            @relation("EnrollmentTeacher", fields: [teacherId], references: [id])
  startDate DateTime         @default(now())
  endDate   DateTime?
  status    EnrollmentStatus @default(ACTIVE)

  @@index([studentId])
  @@index([groupId])
  @@index([teacherId])
}

model Goal {
  id             String         @id @default(cuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseType     CourseType
  targetOverall  String?
  subTargets     Json? // e.g. {"reading":"7.0","listening":"7.5"} or SAT {"rw":700,"math":750}
  targetExamDate DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([studentId])
}

model TaskTemplate {
  id           String       @id @default(cuid())
  courseType   CourseType
  title        String
  category     TaskCategory
  skillArea    String?
  defaultOrder Int          @default(0)

  studentTasks StudentTask[]

  @@index([courseType])
}

model StudentTask {
  id                 String         @id @default(cuid())
  studentId          String
  student            StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  templateId         String?
  template           TaskTemplate?  @relation(fields: [templateId], references: [id])
  title              String
  category           TaskCategory
  courseType         CourseType
  assignedAt         DateTime       @default(now())
  deadline           DateTime?
  status             TaskStatus     @default(NOT_STARTED)
  teacherApproved    Boolean        @default(false)
  score              Float? // 1-5 or percentage; interpreted by scoreType
  scoreMax           Float          @default(5)
  comment            String?
  mistakeReviewDone  Boolean        @default(false)
  studentSubmittedAt DateTime?
  updatedById        String?
  updatedAt          DateTime       @updatedAt

  @@index([studentId, status])
}

model StudentSkillStatus {
  id         String         @id @default(cuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseType CourseType
  skill      String
  status     SkillStatus    @default(NOT_STARTED)
  updatedAt  DateTime       @updatedAt

  @@unique([studentId, skill])
}

model Exam {
  id                String         @id @default(cuid())
  studentId         String
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseType        CourseType
  examType          ExamType
  examDate          DateTime
  sectionScores     Json? // per-course sections, brief §12
  totalScore        String?
  teacherComment    String?
  recommendedAction String?
  createdById       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([studentId, examType])
}

model Attendance {
  id         String           @id @default(cuid())
  studentId  String
  student    StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId    String
  group      Group            @relation(fields: [groupId], references: [id])
  lessonDate DateTime         @db.Date
  status     AttendanceStatus
  note       String?
  markedById String?
  createdAt  DateTime         @default(now())

  @@unique([studentId, groupId, lessonDate])
  @@index([groupId, lessonDate])
}

model ReportCard {
  id             String         @id @default(cuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  period         String // e.g. "2026-09" or "Sep-Oct 2026"
  metrics        Json? // frozen snapshot: attendancePct, taskPct, avgQuality, latestExam, progress
  strengths      String?
  weaknesses     String?
  nextTarget     String?
  teacherComment String?
  publishedAt    DateTime? // null = draft, invisible to student/parent
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([studentId, period])
}

model InternalNote {
  id         String          @id @default(cuid())
  studentId  String?
  student    StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId   String
  author     User            @relation(fields: [authorId], references: [id])
  visibility NoteVisibility  @default(STAFF)
  body       String
  createdAt  DateTime        @default(now())

  @@index([studentId])
  @@index([leadId])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String // email or phone tried
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  success    Boolean
  ip         String?
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

// ---------- reminders (CRM: bell + why we are following up) ----------

model Reminder {
  id           String          @id @default(cuid())
  title        String
  body         String?
  dueAt        DateTime
  status       ReminderStatus  @default(OPEN)
  kind         ReminderKind    @default(MANUAL)
  completedAt  DateTime?
  assignedToId String
  assignedTo   User            @relation("ReminderOwner", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User            @relation("ReminderAuthor", fields: [createdById], references: [id])
  leadId       String?
  lead         Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  studentId    String?
  student      StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staffTaskId  String?
  staffTask    StaffTask?      @relation(fields: [staffTaskId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([assignedToId, status, dueAt])
  @@index([leadId])
  @@index([studentId])
  @@index([staffTaskId])
}

// ---------- staff tasks assigned by the manager, with file hand-in ----------

model StaffTask {
  id           String          @id @default(cuid())
  title        String
  description  String?
  assignedToId String
  assignedTo   User            @relation("StaffTaskAssignee", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User            @relation("StaffTaskAuthor", fields: [createdById], references: [id])
  dueAt        DateTime?
  status       StaffTaskStatus @default(TODO)
  managerNote  String?
  completedAt  DateTime?
  /// A follow-up task points back at the one it came out of.
  parentTaskId String?
  parentTask   StaffTask?      @relation("TaskFollowUp", fields: [parentTaskId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  files     StaffTaskFile[]
  comments  StaffTaskComment[]
  reminders Reminder[]
  followUps StaffTask[]        @relation("TaskFollowUp")

  @@index([assignedToId, status])
  @@index([dueAt])
  @@index([parentTaskId])
  @@index([title])
}

/// Back-and-forth between the manager and whoever is doing the task.
model StaffTaskComment {
  id        String    @id @default(cuid())
  taskId    String
  task      StaffTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime  @default(now())

  @@index([taskId, createdAt])
}

model StaffTaskFile {
  id           String           @id @default(cuid())
  taskId       String
  task         StaffTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  filename     String
  url          String
  pathname     String
  size         Int
  contentType  String?
  uploadedById String
  uploadedBy   User             @relation(fields: [uploadedById], references: [id])
  status       FileReviewStatus @default(PENDING)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())

  @@index([taskId])
}

// ---------- placement / level-check tests taken on screen at the centre ----------

model TestPaper {
  id          String          @id @default(cuid())
  title       String
  courseType  CourseType
  subject     String? // "English level check", "Math"
  description String?
  durationMin Int             @default(30)
  passScore   Float?
  status      TestPaperStatus @default(DRAFT)
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  questions TestQuestion[]
  sittings  TestSitting[]

  @@index([status])
}

model TestQuestion {
  id      String       @id @default(cuid())
  paperId String
  paper   TestPaper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  order   Int          @default(0)
  section String? // "Grammar", "Reading", "Algebra"
  type    QuestionType @default(SINGLE_CHOICE)
  /// The stimulus a question is asked about — a reading passage, a data table,
  /// a scenario. Separate from the prompt because it is laid out beside the
  /// question rather than above it, and several questions may share one.
  passage String?
  prompt  String
  options Json? // ["A","B","C","D"] — null for SHORT_TEXT
  answer  String // option index ("0"), indexes ("0,2"), or accepted text
  points  Float        @default(1)

  @@index([paperId, order])
}

/// One of the five reusable walk-in exam accounts.
model ExamSeat {
  id        String   @id @default(cuid())
  seatNo    Int      @unique // 1..5
  label     String
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  sittings TestSitting[]
}

/// One candidate's attempt at one paper, occupying one seat.
model TestSitting {
  id             String        @id @default(cuid())
  paperId        String
  paper          TestPaper     @relation(fields: [paperId], references: [id])
  seatId         String
  seat           ExamSeat      @relation(fields: [seatId], references: [id])
  candidateName  String
  candidatePhone String?
  leadId         String?
  lead           Lead?         @relation(fields: [leadId], references: [id])
  status         SittingStatus @default(ASSIGNED)
  answers        Json? // { questionId: "0" | "0,2" | "text" }
  score          Float?
  maxScore       Float?
  sectionScores  Json?
  startedAt      DateTime?
  submittedAt    DateTime?
  expiresAt      DateTime?
  reviewNote     String?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([seatId, status])
  @@index([leadId])
  @@index([status])
}

// ---------- background: olympiads, certificates, prior exam results ----------

/// Hangs off a lead OR a student. On conversion the rows are re-pointed at the
/// student profile, so a candidate's record follows them into the academy.
model Achievement {
  id          String              @id @default(cuid())
  leadId      String?
  lead        Lead?               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  studentId   String?
  student     StudentProfile?     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  category    AchievementCategory @default(OTHER)
  result      String? // "2nd place", "IELTS 7.5", "Gold medal"
  achievedOn  DateTime?
  note        String?
  createdById String
  createdBy   User                @relation(fields: [createdById], references: [id])
  createdAt   DateTime            @default(now())

  @@index([leadId])
  @@index([studentId])
}

// ---------- internal messages between staff ----------

model Message {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId, readAt])
  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
}

// ---------- public website content, edited from inside the portal ----------

model Post {
  id          String     @id @default(cuid())
  slug        String     @unique
  status      PostStatus @default(DRAFT)
  category    String?
  coverImage  String?
  titleEn     String
  titleAz     String?
  excerptEn   String?
  excerptAz   String?
  bodyEn      String
  bodyAz      String?
  publishedAt DateTime?
  authorId    String?
  author      User?      @relation(fields: [authorId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, publishedAt])
}

/// Editable landing-page text, one row per block (hero, contacts, stats...).
model SiteSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}
